[Unit]
Description=司命纯脚本看门狗巡检 (siming-watchdog)

[Service]
Type=oneshot
WorkingDirectory=%h/Work/siming
Environment=TMPDIR=%h/.cache/agent-tmp
Environment=NO_PROXY=localhost,127.0.0.1,::1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/siming watchdog
TimeoutStartSec=30
