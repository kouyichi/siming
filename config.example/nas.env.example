# 可选：NAS Homelab 栈环境变量示例（配合 deploy/nas/docker-compose.nas.yml）
# 保存为 .env（chmod 600），严禁提交到 Git

NAS_BIND_IP=127.0.0.1
NAS_DATA_ROOT=/volume1/docker/siming-homelab
NAS_SECRETS_ROOT=/volume1/docker/siming-homelab/secrets

SURE_IMAGE_TAG=stable
SURE_DB_NAME=sure_production
SURE_DB_USER=sure
SURE_DB_PASSWORD=replace_with_strong_password
SURE_REDIS_PASSWORD=replace_with_strong_password
SURE_SECRET_KEY_BASE=replace_with_openssl_rand_hex_64
SURE_API_TOKEN=replace_with_sure_api_token

HAOS_IMAGE_TAG=stable
HAOS_URL=http://homeassistant:8123
HAOS_TOKEN=replace_with_ha_long_lived_token

RESTIC_EDGE_REPO=sftp:backup@edge-vps:/srv/restic/siming
BACKUP_INTERVAL_SEC=21600
